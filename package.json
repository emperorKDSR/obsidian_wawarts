{
  "name": "wawarts",
  "version": "1.0.0",
  "description": "A refined, obsidian-native plugin for monitoring recurring bills, subscriptions, dues, and cashflow.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "bills",
    "subscriptions",
    "finance",
    "recurring",
    "budget",
    "dues"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "builtin-modules": "4.0.0",
    "esbuild": "0.24.2",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "^5.7.2"
  }
}
